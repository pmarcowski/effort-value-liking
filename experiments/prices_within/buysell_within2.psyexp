        <Param val="blue = new util.Color([0, 0, 1]);&amp;#10;green = new util.Color([0, 1, 0]);&amp;#10;red = new util.Color([1, 0, 0]);&amp;#10;win=psychoJS.window;&amp;#10;event=psychoJS.eventManager;&amp;#10;scale_order = ['Buyer', 'Seller'];&amp;#10;scale_order = util.shuffle(scale_order);&amp;#10;step_distance = 1000-150;&amp;#10;step_low_base = step_distance/30;&amp;#10;step_medium_base = step_distance/100;&amp;#10;step_high_base = step_distance/270;&amp;#10;step_low = step_low_base + (1-(step_low_base % 1));&amp;#10;step_medium = step_medium_base + (1-(step_medium_base % 1));&amp;#10;step_high = step_high_base + (1-(step_high_base % 1));&amp;#10;this_trial = 0;&amp;#10;rest_time = 15;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
