      <CodeComponent name="code_attention_check" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="button_numbers = [1, 2, 3, 4, 5];" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="correct_button = 0;&amp;#10;if ((this_trial === 10)) {&amp;#10;    continueRoutine = true;&amp;#10;    correct_button = util.randchoice(button_numbers);&amp;#10;    attention_text = (&quot;Please click button number &quot; + correct_button);&amp;#10;} else {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
