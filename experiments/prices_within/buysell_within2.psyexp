      <CodeComponent name="code_ready_trial" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="this_img = list_img.splice((- 1), 1);&amp;#10;this_trial += 1;&amp;#10;if ((this_trial &lt;= 9)) {&amp;#10;    scale_type = scale_order[0];&amp;#10;} else {&amp;#10;    if ((this_trial &gt; 9)) {&amp;#10;        scale_type = scale_order[1];&amp;#10;    }&amp;#10;}&amp;#10;&amp;#10;fcounter = 0;&amp;#10;figure_pos = (- 500);&amp;#10;traveled = 0;&amp;#10;collected = false;&amp;#10;if ((effort_level === &quot;low&quot;)) {&amp;#10;    step_size = step_low;&amp;#10;} else {&amp;#10;    if ((effort_level === &quot;medium&quot;)) {&amp;#10;        step_size = step_medium;&amp;#10;    } else {&amp;#10;        if ((effort_level === &quot;high&quot;)) {&amp;#10;            step_size = step_high;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;keyup = 0;&amp;#10;if ((scale_type === &quot;Buyer&quot;)) {&amp;#10;    marker_color = blue;&amp;#10;    block_text='In this part of the experiment,\nyou will be a buyer of the art pieces you collect';&amp;#10;    task_text = &quot;Perform the effort to access this art piece&quot;;&amp;#10;    complete_text = &quot;You sucessfuly performed the steps.\nYou are now a buyer of this art piece\n&quot;;&amp;#10;    scale_text = &quot;Now that you are a buyer,\nhow much would you spend to own this art piece?\n&quot;;&amp;#10;    scale_labels = [&quot;$100&quot;, &quot;$200&quot;, &quot;$300&quot;, &quot;$400&quot;, &quot;$500&quot;];&amp;#10;}&amp;#10;if ((scale_type === &quot;Seller&quot;)) {&amp;#10;    marker_color = green;&amp;#10;    block_text='In this part of the experiment,\nyou will be a seller of the art pieces you collect';&amp;#10;    task_text = &quot;Perform the effort to access this art piece&quot;;&amp;#10;    complete_text = &quot;You sucessfuly performed the steps.\nYou are now the owner of this art piece\n&quot;;&amp;#10;    scale_text = &quot;Now that you are the owner,\nhow much would you sell this art piece for?\n&quot;;&amp;#10;    scale_labels = [&quot;$100&quot;, &quot;$200&quot;, &quot;$300&quot;, &quot;$400&quot;, &quot;$500&quot;];&amp;#10;}" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
