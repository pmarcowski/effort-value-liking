    <Routine name="Setup">
      <CodeComponent name="init_options">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="from time import gmtime, strftime, localtime&amp;#10;import random&amp;#10;import pandas as pd&amp;#10;import csv&amp;#10;import numpy&amp;#10;import re&amp;#10;&amp;#10;#Setup paths&amp;#10;pre_str0='txt/'&amp;#10;pre_str1='trials/'&amp;#10;pre_str2='data/'&amp;#10;&amp;#10;#Shorten procedure if test run or debug&amp;#10;testing=True&amp;#10;&amp;#10;if testing==False:&amp;#10;    n_instr=1&amp;#10;    stimuli=pd.read_csv(pre_str1+'trialStim.txt', delimiter='\t')&amp;#10;&amp;#10;elif testing==True:&amp;#10;    n_instr=1&amp;#10;    stimuli=pd.read_csv(pre_str1+'trialStim_test.txt', delimiter='\t')&amp;#10;&amp;#10;#Set parameters for rating scales&amp;#10;navig1 = dict(leftKeys='f', rightKeys='k', acceptKeys='space',&amp;#10;              choices=['$0.10','$0.25','$0.45','$0.75','$1'],&amp;#10;              markerStart='$0.45', marker='circle',&amp;#10;              textColor ='white',&amp;#10;              markerColor='red',  &amp;#10;              showAccept=False, pos=(0, -0.4),&amp;#10;              noMouse=True)&amp;#10;&amp;#10;#Run blocks depending on group condition&amp;#10;if expInfo['Group']=='1':&amp;#10;    cond = '1'&amp;#10;    scale_condition='Buy'&amp;#10;    task_text=&quot;Perform the effort to access this art piece&quot;&amp;#10;    complete_text=&quot;You sucessfuly performed the steps.\nYou are now a buyer of this art piece\n&quot;&amp;#10;    scale_text=&quot;Now that you are a buyer,\nhow much would you spend to own this art piece?\n&quot;&amp;#10;    offer_info=&quot;We will now select one of the art pieces and compare our price with your buying offer.\n\nCall the experimenter for the transaction.&quot;&amp;#10;    navig=navig1&amp;#10;    with open(pre_str0+'instructionsBuy.txt') as f: &amp;#10;        textTask=f.read().strip()&amp;#10;&amp;#10;elif expInfo['Group']=='2':&amp;#10;    cond = '2'&amp;#10;    scale_condition='Sell'&amp;#10;    task_text=&quot;Perform the effort to access this art piece&quot;&amp;#10;    complete_text=&quot;You sucessfuly performed the steps.\nYou are now the owner of this art piece\n&quot;&amp;#10;    scale_text=&quot;Now that you are the owner,\nhow much would you sell this art piece for?\n&quot;&amp;#10;    offer_info=&quot;We will now select one of the art pieces and compare our price with your selling offer.\n\nCall the experimenter for the transaction.&quot;&amp;#10;    navig=navig1&amp;#10;    with open(pre_str0+'instructionsSell.txt') as f: &amp;#10;        textTask=f.read().strip()&amp;#10;&amp;#10;textIntro=''&amp;#10;with open(pre_str0+'instructionsGeneral.txt') as f: &amp;#10;    textIntro=f.read().strip()&amp;#10;&amp;#10;#Read stimuli files&amp;#10;colnames=['trialNum', 'effortLevelTrain', 'effortRepTrain', &amp;#10;          'stimTrain', 'effortLevelProc', 'effortRepProc', 'stimProc']&amp;#10;&amp;#10;effortsListTrain=stimuli.effortLevelTrain.tolist()&amp;#10;effortsListProc=stimuli.effortLevelProc.tolist()&amp;#10;imageListTrain=stimuli.stimTrain.tolist()&amp;#10;imageListProc=stimuli.stimProc.tolist()&amp;#10;&amp;#10;#Drop NaNs&amp;#10;effortsListTrain=[f for f in effortsListTrain if str(f) != 'nan']&amp;#10;effortsListProc=[f for f in effortsListProc if str(f) != 'nan']&amp;#10;imageListTrain=[f for f in imageListTrain if str(f) != 'nan']&amp;#10;imageListProc=[f for f in imageListProc if str(f) != 'nan']&amp;#10;&amp;#10;#Randomize image order&amp;#10;#This randomized list is used for presenting the images&amp;#10;imageListRandTrain=random.sample(imageListTrain, len(imageListTrain))&amp;#10;imageListRandProc=random.sample(imageListProc, len(imageListProc))&amp;#10;&amp;#10;#Get the participant and group info for naming data files&amp;#10;subjectID=expInfo['Participant_number']&amp;#10;subjectGroup=expInfo['Group']&amp;#10;&amp;#10;#Number of trials&amp;#10;trialsTrain=len(effortsListTrain)&amp;#10;trialsProc=len(effortsListProc)&amp;#10;&amp;#10;#Setup data logging&amp;#10;root_dir=os.getcwd()&amp;#10;data_dir=os.path.join(root_dir, 'data')&amp;#10;fname_order=pre_str2+str(subjectID)+'_'+str(subjectGroup)+'_'+'imgOrder.csv'&amp;#10;fname_data=str(subjectID)+'_'+str(subjectGroup)+'_'+'data.csv'&amp;#10;fname_data_practice=str(subjectID)+'_'+str(subjectGroup)+'_'+'data_practice.csv'&amp;#10;fname_sub=str(subjectID)+'_'+str(subjectGroup)+'_'+'subjectInfo.csv'&amp;#10;dataColTrain=['condition', 'id', 'trialPractice', 'effort', 'stim', 'scaleRating', 'scaleRT']&amp;#10;dataCol=['condition', 'id', 'trial', 'effort', 'stim', 'scaleRating', 'scaleRT']&amp;#10;subCol=['subjID', 'group', 'sex', 'age', 'height', 'weight', 'time']&amp;#10;df=pd.DataFrame(columns=dataCol)&amp;#10;df_practice=pd.DataFrame(columns=dataColTrain)&amp;#10;df_sub=pd.DataFrame(columns=subCol)&amp;#10;&amp;#10;with open(fname_order,'w', newline='') as w: &amp;#10;  writer=csv.writer(w) &amp;#10;  writer.writerow(['imageListProc']) &amp;#10;  for i in range(len(imageListRandProc)): &amp;#10;    writer.writerow([imageListRandProc[i]])&amp;#10;&amp;#10;def fill_df_from_LikertTrain(df_practice, trialTrain, scaleRating, scaleRT):&amp;#10;                                 row_idx = df_practice.shape[0]+1&amp;#10;                                 df_practice.loc[row_idx, 'condition']=scale_condition&amp;#10;                                 df_practice.loc[row_idx, 'id']=subjectID&amp;#10;                                 df_practice.loc[row_idx, 'trialPractice']=trialTrain&amp;#10;                                 df_practice.loc[row_idx, 'effort']=thisEffort&amp;#10;                                 df_practice.loc[row_idx, 'stim']=imageItem&amp;#10;                                 df_practice.loc[row_idx, 'time']=thisTime&amp;#10;                                 df_practice.loc[row_idx, 'scaleRating']=currentRating.getRating()&amp;#10;                                 df_practice.loc[row_idx, 'scaleRT']=currentRating.getRT()&amp;#10;&amp;#10;def fill_df_from_Likert(df, trial, scaleRating, scaleRT):&amp;#10;                           row_idx = df.shape[0]+1&amp;#10;                           df.loc[row_idx, 'condition']=scale_condition&amp;#10;                           df.loc[row_idx, 'id']=subjectID&amp;#10;                           df.loc[row_idx, 'trial']=trial&amp;#10;                           df.loc[row_idx, 'effort']=thisEffort&amp;#10;                           df.loc[row_idx, 'stim']=imageItem&amp;#10;                           df.loc[row_idx, 'time']=thisTime&amp;#10;                           df.loc[row_idx, 'scaleRating']=currentRating.getRating()&amp;#10;                           df.loc[row_idx, 'scaleRT']=currentRating.getRT()" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="#Save subject info&amp;#10;df_sub.loc[0, 'subjID']=subjectID&amp;#10;df_sub.loc[0, 'group']=subjectGroup&amp;#10;df_sub.loc[0, 'sex']=expInfo['Sex']&amp;#10;df_sub.loc[0, 'age']=expInfo['Age']&amp;#10;df_sub.loc[0, 'height']=expInfo['Height']&amp;#10;df_sub.loc[0, 'weight']=expInfo['Weight']&amp;#10;df_sub.loc[0, 'time']=strftime(&quot;%Y-%m-%d %H:%M:%S&quot;, localtime())&amp;#10;df_sub.to_csv(os.path.join(data_dir, fname_sub))&amp;#10;" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Py" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="init_options" valType="code"/>
      </CodeComponent>
    </Routine>
    <Routine name="startTraining">
      <CodeComponent name="codeTrain">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
