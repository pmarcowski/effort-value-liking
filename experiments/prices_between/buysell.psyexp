      <CodeComponent name="codeTimeTravel">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="# Read current participant choices&amp;#10;travel=pd.read_csv(pre_str2+fname_data)&amp;#10;time_travel=travel[['stim','scaleRating']].head()&amp;#10;&amp;#10;# Select response row from a random trial&amp;#10;travel_trans=time_travel.sample(n=1)&amp;#10;&amp;#10;# Get image from the randomly selected trial&amp;#10;travel_stim=travel_trans['stim'].iloc[0]&amp;#10;&amp;#10;# Get scale response from the randomly selected trial&amp;#10;travel_mon_c=travel_trans[['scaleRating']].iloc[0]&amp;#10;travel_mon=float(travel_mon_c.astype(str).str.replace('$',''))&amp;#10;&amp;#10;# Generate random amount&amp;#10;exp_mon=round(random.uniform(0.10,1),2)&amp;#10;&amp;#10;# Compare participant amount with exp amount&amp;#10;if cond=='1':&amp;#10;    if travel_mon &gt; exp_mon:&amp;#10;        travel_text=&quot;Your offer: $&quot;+str('{:.2f}'.format(travel_mon))+&quot;.&quot;&amp;#10;        exp_text=&quot;Our price: $&quot;+str('{:.2f}'.format(exp_mon))+&quot;.&quot;&amp;#10;        travel_result1=&quot;Your offer is higher than our price.&quot;&amp;#10;        travel_result2=&quot;You buy the art piece.&quot;&amp;#10;    else:&amp;#10;        travel_text=&quot;Your offer: $&quot;+str('{:.2f}'.format(travel_mon))+&quot;.&quot;&amp;#10;        exp_text=&quot;Our price: $&quot;+str('{:.2f}'.format(exp_mon))+&quot;.&quot;&amp;#10;        travel_result1=&quot;Your offer is lower than our price.&quot;&amp;#10;        travel_result2=&quot;You keep the money.&quot;&amp;#10;&amp;#10;elif cond=='2':&amp;#10;    if travel_mon &lt; exp_mon:&amp;#10;        travel_text=&quot;Your offer: $&quot;+str('{:.2f}'.format(travel_mon))+&quot;.&quot;&amp;#10;        exp_text=&quot;Our price: $&quot;+str('{:.2f}'.format(exp_mon))+&quot;.&quot;&amp;#10;        travel_result1=&quot;Your offer is lower than our price.&quot;&amp;#10;        travel_result2=&quot;You sell the art piece.&quot;&amp;#10;    else:&amp;#10;        travel_text=&quot;Your offer: $&quot;+str('{:.2f}'.format(travel_mon))+&quot;.&quot;&amp;#10;        exp_text=&quot;Our price: $&quot;+str('{:.2f}'.format(exp_mon))+&quot;.&quot;&amp;#10;        travel_result1=&quot;Your offer is higher than our price.&quot;&amp;#10;        travel_result2=&quot;You keep the art piece.&quot;" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Py" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
