        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="#keys_rate = key_rate.getKeys(['f', 'k', 'space'], waitRelease=True)&amp;#10;&amp;#10;#if 'f' in keys_rate or 'k' in keys_rate:&amp;#10;#    for key in keys_rate:&amp;#10;#        if key == 'f':&amp;#10;#            scale.markerPos-=1&amp;#10;#        elif key == 'k':&amp;#10;#            scale.markerPos+=1&amp;#10;#    scale.recordRating(scale.markerPos)&amp;#10;#    scale_rating = scale.getRating()&amp;#10;#    scale_rt = scale.getRT()&amp;#10;#    show_confirm = True&amp;#10;&amp;#10;#if show_confirm:&amp;#10;#    if 'space' in keys_rate:&amp;#10;#        continueRoutine=False" valType="extendedCode" updates="constant" name="Each Frame"/>
