        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="scale_rating = scale.getRating();&amp;#10;scale_rt = scale.getRT();&amp;#10;load_order += load_type;&amp;#10;psychoJS.experiment.addData(&quot;load_comp&quot;, load_type);&amp;#10;psychoJS.experiment.addData(&quot;load_rating&quot;, scale_rating);&amp;#10;psychoJS.experiment.addData(&quot;load_rt&quot;, scale_rt);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="scale_rating = scale.getRating()&amp;#10;scale_rt = scale.getRT()&amp;#10;&amp;#10;load_order += load_type&amp;#10;&amp;#10;thisExp.addData('load_comp', load_type)&amp;#10;thisExp.addData('load_rating', scale_rating)&amp;#10;thisExp.addData('load_rt', scale_rt)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
