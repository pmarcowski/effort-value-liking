<?xml version="1.0" ?>
<PsychoPy2experiment encoding="utf-8" version="2022.1.4">
  <Settings>
    <Param val="use prefs" valType="str" updates="None" name="Audio latency priority"/>
    <Param val="use prefs" valType="str" updates="None" name="Audio lib"/>
    <Param val="$&quot;https://psychodpt.fra1.qualtrics.com/jfe/form/SV_9yNrzDYtOcjoTXg?experiment_id=&quot;+expInfo['experiment_id']+&quot;&amp;credit_token=&quot;+expInfo['credit_token']+&quot;&amp;experiment_name=&quot;+expInfo['experiment_name']+&quot;&amp;id=&quot;+expInfo['id']" valType="str" updates="None" name="Completed URL"/>
    <Param val="auto" valType="str" updates="None" name="Data file delimiter"/>
