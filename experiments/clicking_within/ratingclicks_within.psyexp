        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="False" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="TASK INSTRUCTIONS&amp;#10;&amp;#10;Thank you for agreeing to participate in today's experiment!&amp;#10;&amp;#10;Please make sure to read all following instructions carefully.&amp;#10;&amp;#10;You will be asked to collect a number of calligraphy art pieces. Each calligraphy is associated with a different level of effort, i.e., number of steps needed to collect it.&amp;#10;&amp;#10;When a calligraphy is presented, collect it by pressing [SPACE] for each step necessary. When the number of steps needed to collect a given calligraphy is reached, you will proceed to the next one. Try performing the steps as quickly as you can. Note that each calligraphy will be presented on the screen for a limited amount of time.&amp;#10;&amp;#10;After each calligraphy is collected you will be asked one of two separate questions about it. These two questions are independent and will be asked in different parts of the experiment. Use the scale presented on the screen to answer these questions. Use the mouse to navigate the response scale and confirm your choice. &amp;#10;&amp;#10;There will be a 15 second rest period following the collection and rating of each calligraphy." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1.25" valType="num" updates="constant" name="wrapWidth"/>
