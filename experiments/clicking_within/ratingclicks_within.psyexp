        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="scale_rating = scale_2.getRating();&amp;#10;scale_rt = scale_2.getRT();&amp;#10;load_order += load_type;&amp;#10;psychoJS.experiment.addData(&quot;block&quot;, &quot;taskload&quot;);&amp;#10;psychoJS.experiment.addData(&quot;load_order&quot;, load_order);&amp;#10;psychoJS.experiment.addData(&quot;trial&quot;, this_trial);&amp;#10;psychoJS.experiment.addData(&quot;effort&quot;, effort_level);&amp;#10;psychoJS.experiment.addData(&quot;effort_time&quot;, effort_time);&amp;#10;psychoJS.experiment.addData(&quot;load_type&quot;, load_type);&amp;#10;psychoJS.experiment.addData(&quot;load_rating&quot;, scale_rating);&amp;#10;psychoJS.experiment.addData(&quot;load_rt&quot;, scale_rt);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="scale_rating = scale_2.getRating()&amp;#10;scale_rt = scale_2.getRT()&amp;#10;&amp;#10;load_order += load_type&amp;#10;&amp;#10;thisExp.addData('block', 'taskload')&amp;#10;thisExp.addData('load_order', load_order)&amp;#10;thisExp.addData('trial', this_trial)&amp;#10;thisExp.addData('effort', effort_level)&amp;#10;thisExp.addData('effort_time', effort_time)&amp;#10;thisExp.addData('load_type', load_type)&amp;#10;thisExp.addData('load_rating', scale_rating)&amp;#10;thisExp.addData('load_rt', scale_rt)" valType="extendedCode" updates="constant" name="End Routine"/>
