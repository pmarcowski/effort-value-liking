    <Routine name="collect"/>
    <Routine name="rate">
      <CodeComponent name="code_scale">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((scale_type === &quot;Value&quot;)) {&amp;#10;    marker_color = &quot;blue&quot;;&amp;#10;    scale_text = &quot;What is the value of this calligraphy?&quot;;&amp;#10;    scale_labels = [&quot;$100&quot;, &quot;$200&quot;, &quot;$300&quot;, &quot;$400&quot;, &quot;$500&quot;];&amp;#10;}&amp;#10;if ((scale_type === &quot;Liking&quot;)) {&amp;#10;    marker_color = &quot;green&quot;;&amp;#10;    scale_text = &quot;How much do you like this calligraphy?&quot;;&amp;#10;    scale_labels = [&quot;really don't like it&quot;, &quot;really like it&quot;];&amp;#10;}&amp;#10;random_pos = util.randint(1, 5);&amp;#10;scale = new visual.Slider({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;slider&quot;, &quot;size&quot;: [0.75, 0.075], &quot;pos&quot;: [0, (- 0.2)], &quot;units&quot;: &quot;height&quot;, &quot;labels&quot;: scale_labels, &quot;startValue&quot;: random_pos, &quot;granularity&quot;: 0, &quot;style&quot;: [&quot;rating&quot;], &quot;color&quot;: &quot;LightGray&quot;, &quot;markerColor&quot;: marker_color, &quot;font&quot;: &quot;OpenSans&quot;, &quot;flip&quot;: false});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if scale_type == 'Value':&amp;#10;    marker_color = &quot;blue&quot;&amp;#10;    scale_text = &quot;What is the value of this calligraphy?&quot;&amp;#10;    scale_labels = [&quot;$100&quot;, &quot;$200&quot;, &quot;$300&quot;, &quot;$400&quot;, &quot;$500&quot;]&amp;#10;&amp;#10;if scale_type == 'Liking':&amp;#10;    marker_color = &quot;green&quot;&amp;#10;    scale_text = &quot;How much do you like this calligraphy?&quot;&amp;#10;    scale_labels = [&quot;really don't like it&quot;, &quot;really like it&quot;]&amp;#10;&amp;#10;random_pos = randint(1,5)&amp;#10;scale = visual.Slider(win=win, name='slider',&amp;#10;    size=(0.75, 0.075), pos=(0, -0.2), units='height',&amp;#10;    labels=scale_labels, startValue = random_pos,&amp;#10;    granularity=0, style=('rating',),&amp;#10;    color='LightGray', markerColor = marker_color,&amp;#10;    font='OpenSans', flip=False)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/*&amp;#10;scale_order += scale_type;&amp;#10;if ((scale_type === &quot;Value&quot;)) {&amp;#10;    psychoJS.experiment.addData(&quot;value_rating&quot;, scale.getRating());&amp;#10;    psychoJS.experiment.addData(&quot;value_rt&quot;, scale.getRT());&amp;#10;}&amp;#10;if ((scale_type === &quot;Liking&quot;)) {&amp;#10;    psychoJS.experiment.addData(&quot;liking_rating&quot;, scale.getRating());&amp;#10;    psychoJS.experiment.addData(&quot;liking_rt&quot;, scale.getRT());&amp;#10;}&amp;#10;*/&amp;#10;psychoJS.experiment.addData('condition', cond);&amp;#10;psychoJS.experiment.addData('scale_outcome', scale.getRating());&amp;#10;psychoJS.experiment.addData('scale_outcome_rt', scale.getRT())&amp;#10;//psychoJS.experiment.addData(&quot;scale_order&quot;, scale_order);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#scale_order += scale_type&amp;#10;&amp;#10;#if scale_type == 'Value':&amp;#10;#    thisExp.addData('value_rating', scale.getRating())&amp;#10;#    thisExp.addData('value_rt', scale.getRT())&amp;#10;#&amp;#10;#if scale_type == 'Liking':&amp;#10;#    thisExp.addData('liking_rating', scale.getRating())&amp;#10;#    thisExp.addData('liking_rt', scale.getRT())&amp;#10;&amp;#10;thisExp.addData('condition', cond)&amp;#10;thisExp.addData('scale_outcome', scale.getRating())&amp;#10;thisExp.addData('scale_outcome_rt', scale.getRT())&amp;#10;#thisExp.addData('scale_order', scale_order)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_scale" valType="code" updates="None" name="name"/>
      </CodeComponent>
